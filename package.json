{
  "name": "jamotextile",
  "version": "0.1.0",
  "private": true,
  "description": "JAMO Textile B2B portal: customer ordering and admin back office for branded corporate clothing",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "next": "15.5",
    "react": "19.1",
    "react-dom": "19.1",
    "server-only": "^0.0.1",
    "zod": "3.25"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5",
    "postcss": "^8.5.29",
    "prisma": "6.19",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
