# PostgreSQL connection string
DATABASE_URL="postgresql://jamo:jamo@localhost:5432/jamo?schema=public"

# Session signing secrets. Use different, long random values for each
# (generate with: openssl rand -base64 48). Never share them between portals.
AUTH_ADMIN_SECRET="change-me-admin-secret-at-least-32-characters"
AUTH_CUSTOMER_SECRET="change-me-customer-secret-at-least-32-chars"

# Password for the first admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@jamotextile.uz"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# SMS delivery for customer login codes: "console" (dev) or "eskiz" (planned)
SMS_PROVIDER="console"
